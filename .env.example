# Spotify-App-Zugangsdaten (Developer Dashboard: https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Muss exakt einer im Dashboard registrierten Redirect-URI entsprechen.
# Erlaubt sind nur https://-Adressen oder Loopback-IP-Literale, z. B.:
#   https://blockshuffle.meine-domain.de/callback
#   http://127.0.0.1:8973/callback
# "localhost" ist von Spotify generell verboten, LAN-IPs über http ebenfalls.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8973/callback

# Port des Webservers (Default 8973)
PORT=8973

# Verzeichnis für persistente Daten (SQLite). Im Container: /config
DATA_DIR=./data
